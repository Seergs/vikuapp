{
  "sourceLanguage" : "en",
  "strings" : {
    "To use another server, add a new connection." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To use another server, add a new connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para usar otro servidor, añade una nueva conexión."
          }
        }
      }
    },
    "This connection belongs to another user. Use the original account or add a new connection." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This connection belongs to another user. Use the original account or add a new connection."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conexión pertenece a otro usuario. Inicia sesión con la cuenta original o añade una nueva conexión."
          }
        }
      }
    },
    "This connection changed while you were signing in. Try again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This connection changed while you were signing in. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta conexión cambió mientras iniciabas sesión. Inténtalo de nuevo."
          }
        }
      }
    },
    "Couldn't verify your user. Try signing in again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't verify your user. Try signing in again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo verificar tu usuario. Intenta iniciar sesión de nuevo."
          }
        }
      }
    },
    "This token needs permission to read your user. Update its permissions and try again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This token needs permission to read your user. Update its permissions and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este token necesita permiso para consultar tu usuario. Actualiza sus permisos e inténtalo de nuevo."
          }
        }
      }
    },
    "A Kanban column has reached its task limit. Free up space in the board and try again.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kanban column has reached its task limit. Free up space in the board and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una columna Kanban alcanzó su límite de tareas. Libera espacio en el tablero y vuelve a intentarlo."
          }
        }
      }
    },
    "Column “%@” in the “%@” Kanban board has reached its task limit.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Column “%@” in the “%@” Kanban board has reached its task limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La columna «%1$@» del tablero de «%2$@» alcanzó su límite de tareas."
          }
        }
      }
    },
    "No tasks were changed. Column “%@” in the “%@” Kanban board cannot fit the selection.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tasks were changed. Column “%@” in the “%@” Kanban board cannot fit the selection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se modificó ninguna tarea. La columna «%1$@» del tablero de «%2$@» no tiene espacio para todas las tareas seleccionadas."
          }
        }
      }
    },
    "Couldn’t complete. Column “%@” in the “%@” Kanban board is full.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t complete. Column “%@” in the “%@” Kanban board is full."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la tarea. La columna «%1$@» del tablero de «%2$@» alcanzó su límite de tareas."
          }
        }
      }
    },
    "Couldn’t mark as pending. Column “%@” in the “%@” Kanban board is full.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t mark as pending. Column “%@” in the “%@” Kanban board is full."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo marcar como pendiente. La columna «%1$@» del tablero de «%2$@» alcanzó su límite de tareas."
          }
        }
      }
    },
    "No tasks were changed. A destination column in the Kanban board cannot fit the selection.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tasks were changed. A destination column in the Kanban board cannot fit the selection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se modificó ninguna tarea. Una columna de destino del tablero Kanban no tiene espacio para todas las tareas seleccionadas."
          }
        }
      }
    },
    "Couldn’t complete. A destination column in this task’s Kanban board is full.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t complete. A destination column in this task’s Kanban board is full."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la tarea. Una columna de destino de su tablero Kanban alcanzó su límite de tareas."
          }
        }
      }
    },
    "Couldn’t mark as pending. A destination column in this task’s Kanban board is full.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t mark as pending. A destination column in this task’s Kanban board is full."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo marcar como pendiente. Una columna de destino de su tablero Kanban alcanzó su límite de tareas."
          }
        }
      }
    },
    "This column is full. Choose another column or try again when space is available.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This column is full. Choose another column or try again when space is available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta columna está llena. Elige otra columna o vuelve a intentarlo cuando haya espacio."
          }
        }
      }
    },
    "You're offline. Data will update when you're connected again." : {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás sin conexión. Los datos se actualizarán cuando vuelvas a conectarte."
          }
        }
      }
    },
    "Couldn't reach that server. Check the address and your connection." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar con ese servidor. Revisa la dirección y tu conexión."
          }
        }
      }
    },
    "That address didn't respond like a Vikunja instance." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa dirección no respondió como una instancia de Vikunja."
          }
        }
      }
    },
    "That address uses an insecure http connection." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa dirección usa una conexión http insegura."
          }
        }
      }
    },
    "That doesn't look like a valid instance address." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eso no parece una dirección de instancia válida."
          }
        }
      }
    },
    "That server rejected the request." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese servidor rechazó la solicitud."
          }
        }
      }
    },
    "The request timed out. Check your connection and try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La solicitud tardó demasiado. Revisa tu conexión e inténtalo de nuevo."
          }
        }
      }
    },
    "The server responded with an error (%lld)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {

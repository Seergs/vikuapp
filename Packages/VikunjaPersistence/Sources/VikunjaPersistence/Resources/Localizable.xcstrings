{
  "sourceLanguage": "en",
  "strings": {
    "Some changes could not be synced. Check Pending Sync in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some changes could not be synced. Check Pending Sync in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron sincronizar algunos cambios. Revisa Sincronización pendiente en Ajustes."
          }
        }
      }
    },
    "Kanban column unavailable. Delete this local task and create it in another column.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanban column unavailable. Delete this local task and create it in another column."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Columna Kanban no disponible. Elimina esta tarea local y créala en otra columna."
          }
        }
      }
    },
    "Creation unconfirmed. Check server before recreating this task. Automatic retry is paused.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creation unconfirmed. Check server before recreating this task. Automatic retry is paused."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Creación sin confirmar. Revisa el servidor antes de eliminar o recrear esta tarea. El reintento automático está pausado."
          }
        }
      }
    },
    "Kanban rejected. Check capacity and permissions, then delete and recreate this task.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanban rejected. Check capacity and permissions, then delete and recreate this task."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Creación Kanban rechazada. Revisa la capacidad y los permisos antes de eliminar y recrear esta tarea local."
          }
        }
      }
    },
    "Move rejected. Check column capacity and access, then choose another column.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move rejected. Check column capacity and access, then choose another column."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Movimiento rechazado. Revisa la capacidad y el acceso de la columna y elige otra."
          }
        }
      }
    },
    "The server placement changed. Check the server, then choose another column.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server placement changed. Check the server, then choose another column."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La posición cambió en el servidor. Revisa el servidor y elige otra columna."
          }
        }
      }
    },
    "Move unconfirmed. Check the server before choosing another column.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move unconfirmed. Check the server before choosing another column."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Movimiento sin confirmar. Revisa el servidor antes de elegir otra columna."
          }
        }
      }
    }
  },
  "version": "1.0"
}

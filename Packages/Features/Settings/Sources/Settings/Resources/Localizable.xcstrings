    "Viku is an independent, unofficial client and isn't affiliated with the Vikunja project. Vikunja itself is licensed under AGPLv3." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viku es un cliente independiente, no oficial, y no está afiliado al proyecto Vikunja. Vikunja mismo está licenciado bajo AGPLv3."
          }
        }
      }
    },
    "Viku only talks to the Vikunja instance you connect it to. Your tasks and credentials never pass through any other server." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viku solo se comunica con la instancia de Vikunja a la que te conectas. Tus tareas y credenciales nunca pasan por ningún otro servidor."
          }
        }
      }
    },
